#!/usr/bin/env python3
"""A stand-in for `claude -p --output-format stream-json`: no model, just believable events (demo and screenshots)."""
import json, sys, time, uuid
if "--version" in sys.argv:
    print("2.1.0 (Claude Code)"); sys.exit(0)
prompt = sys.stdin.read()
sid = next((sys.argv[i + 1] for i, a in enumerate(sys.argv) if a == "--resume"), str(uuid.uuid4()))
def out(ev): print(json.dumps(ev), flush=True)
out({"type": "system", "subtype": "init", "session_id": sid})
slow = "release notes" in prompt.lower() or "unit tests" in prompt.lower()  # long enough to see it running
steps = [("Bash", {"command": "npm ci", "description": "Install dependencies"}, "added 812 packages in 14s"),
         ("Bash", {"command": "npm test -- --reporter=dot", "description": "Run the unit tests"}, "Tests: 2 failed, 214 passed"),
         ("Read", {"file_path": "src/cart/total.test.ts"}, "(file contents)"),
         ("Edit", {"file_path": "src/cart/total.ts"}, "updated"),
         ("Bash", {"command": "npm test -- --reporter=dot", "description": "Re-run the unit tests"}, "Tests: 216 passed")]
for i, (name, args, result) in enumerate(steps):
    time.sleep(40 if slow and i == 1 else 1.2)
    call = "toolu_" + uuid.uuid4().hex[:16]
    out({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": call, "name": name, "input": args}]}})
    time.sleep(0.6)
    out({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": call, "content": result}]}})
text = ("All 216 unit tests pass now.\n\n- **Fixed:** `total.ts` rounded each line item before summing; it now sums in cents and rounds once.\n"
        "- **Why it failed:** 2 cases with three-decimal prices (0.125 × 3).\n- Installer built: `dist/desktop-client-2.4.1.dmg`.")
out({"type": "assistant", "message": {"content": [{"type": "text", "text": text}]}})
out({"type": "result", "subtype": "success", "result": text, "session_id": sid,
     "usage": {"input_tokens": 18420, "output_tokens": 1630, "cache_read_input_tokens": 51200}})
